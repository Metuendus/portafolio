---
import Icon from './Icon.astro';
import { ui, projectsPath, summaryPath, contact, cvLabel, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const h = t.hero;
---
<section class="hero page-x">
  <p class="fiche tag">{t.fiche}</p>
  <h1>{h.h1}</h1>
  <p class="sub">{h.sub}</p>
  <div class="ctas">
    <a class="btn btn--primary btn--lg" href={summaryPath(lang)}>{t.quick.open}<Icon name="arrow" /></a>
    <a class="btn btn--secondary btn--lg" href={projectsPath(lang)}>{h.cta1}</a>
    <a class="btn btn--secondary btn--lg" href={contact.cv[lang]} download><Icon name="download" />{cvLabel[lang]}</a>
  </div>

</section>

<style>
  .fiche { margin-bottom: 24px; font-size: 13px; }
  .hero { position: relative; padding-top: 112px; padding-bottom: 96px; display: flex; flex-direction: column; }
  h1 {
    max-width: 1000px; font: 600 var(--jc-fs-hero)/1.05 var(--jc-font-sans); letter-spacing: var(--jc-ls-hero);
    text-wrap: pretty;
  }
  .sub { margin-top: 32px; max-width: 720px; font: 400 20px/1.55 var(--jc-font-sans); color: var(--jc-text-2); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 44px; }

  @media (max-width: 640px) {
    .hero { padding-top: 32px; padding-bottom: 48px; }
    .fiche { margin-bottom: 16px; font-size: 12px; line-height: 1.5; }
    h1 { text-wrap: pretty; }
    .sub { margin-top: 20px; font-size: 17px; }
    .ctas { flex-direction: column; gap: 10px; margin-top: 20px; }
    .ctas .btn { height: 48px; font-size: 15px; width: 100%; }
  }
</style>
