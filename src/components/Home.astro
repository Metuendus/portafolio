---
import Hero from './Hero.astro';
import AgentReplay from './AgentReplay.astro';
import Icon from './Icon.astro';
import OrgChip from './OrgChip.astro';
import CopyButton from './CopyButton.astro';
import CaseCover from './CaseCover.astro';
import Footer from './Footer.astro';
import { ui, casePath, projectsPath, aboutPath, profilePath, showMissing, contact, cvLabel, type Lang } from '../i18n/ui';
import { cases, hasPage } from '../data/cases';
import { fronts, numbers, timeline, authorship, countByFront, examplesByFront, type Credit } from '../data/fronts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const L = t.caseL;
const contactId = lang === 'es' ? 'contacto' : 'contact';
const featured = ['mcp', 'prompts', 'dash', 'iterum'].map((id) => cases.find((c) => c.id === id)!);
const about = aboutPath(lang);
const creditHref = (c: Credit) => (c.case ? casePath(lang, c.case) : c.profile ? profilePath(lang) : c.href);
const wave = [18, 34, 52, 30, 68, 44, 86, 58, 100, 72, 40, 62, 92, 54, 28, 70, 96, 48, 66, 36, 80, 50, 24, 42, 16];
---
<Hero lang={lang} />
<AgentReplay lang={lang} />

<section class="numbers page-x" aria-labelledby="numbers-title">
  <div class="head"><h2 id="numbers-title">{t.numbersTitle}</h2></div>
  <dl class="nums">
    {numbers.map((n) => (
      <div class="num" id={n.proof && `prueba-${n.proof}`} data-proof={n.proof}>
        <dt class="num-l">{n.l[lang]}</dt>
        <dd class="num-v">{n.v}</dd>
        <dd class="num-s">{L.source}: {n.source[lang]}</dd>
      </div>
    ))}
  </dl>
</section>

<section class="block page-x" aria-labelledby="built-title">
  <div class="head">
    <h2 id="built-title">{t.builtTitle}</h2>
    <p class="lede">{t.builtIntro}</p>
  </div>
  <div class="split">
    {authorship.map((g) => (
      <div>
        <h3>{g.title[lang]}</h3>
        <ul class="who">
          {g.items.map((c) => {
            const href = creditHref(c);
            const out = !!c.href;
            return (
              <li>
                {href
                  ? <a class="w-name" href={href} target={out ? '_blank' : undefined} rel={out ? 'noopener' : undefined}>{c.name[lang]}{out && <span class="sr-only">{t.newTab}</span>}</a>
                  : <span class="w-name">{c.name[lang]}</span>}
                <span class="w-note">{c.note[lang].replace(/(\d) %/g, '$1\u00a0%')}</span>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</section>

<section class="block block--cases page-x" aria-labelledby="cases-title">
  <div class="head head--row">
    <div class="head"><h2 id="cases-title">{t.featuredTitle}</h2></div>
    <a class="link" href={projectsPath(lang)}>{t.allWork}<Icon name="arrow" /></a>
  </div>
  <ul class="cases">
    {featured.map((c, i) => {
      const linked = hasPage(c.id);
      return (
        <li>
          <div class:list={['case', { flip: i % 2 === 1, linked }]} id={`prueba-${c.id}`} data-proof={c.id}>
            <div class="shot-wrap"><CaseCover lang={lang} c={c} /></div>
            <div class="body">
              <div class="meta"><span class="cname">{c.name[lang]}</span></div>
              <p class="hook">{c.hook[lang]}</p>
              <div class="chips"><OrgChip lang={lang} org={c.org} status={c.status} /></div>
              <div class="links">
                {linked ? <a class="link read stretch" href={casePath(lang, c.id)}>{t.readCase}<Icon name="arrow" /></a> : <span class="soon tag">{t.soon}</span>}
                {c.app && <a class="link app-open" href={c.app} target="_blank" rel="noopener">{t.apps.open}<Icon name="external" size={16} /><span class="sr-only">{t.newTab}</span></a>}
              </div>
            </div>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<section class="doppel page-x" aria-labelledby="doppel-title">
  <div class="dp-copy">
    <span class="chip chip--live chip--lg"><Icon name="check" size={12} />{t.doppel.chip}</span>
    <h2 id="doppel-title">{t.doppel.title}</h2>
    <p>{t.doppel.body}</p>
    <a class="dp-link" href={`${projectsPath(lang)}?frente=own`}>{t.doppel.more}<Icon name="arrow" /></a>
  </div>
  <div class="wave" aria-hidden="true" data-wave>
    {wave.map((h, i) => <span style={`--h:${h};--i:${i}`}></span>)}
  </div>
</section>

<section class="block page-x" aria-labelledby="thesis">
  <div class="head"><h2 id="thesis">{t.thesisTitle}</h2></div>
  <ol class="principles">
    {t.principles.map((p) => (
      <li>
        <h3>{p.t}</h3>
        <p>{p.d}</p>
        {hasPage(p.case)
          ? <a class="link" href={casePath(lang, p.case)}>{p.app}</a>
          : <span class="app">{p.app}</span>}
      </li>
    ))}
  </ol>
</section>

<section class="block page-x" aria-labelledby="timeline-title">
  <div class="head head--row">
    <div class="head"><h2 id="timeline-title">{t.timelineTitle}</h2></div>
    <a class="link" href={about}>{t.nav.find((n) => n.key === 'about')!.label}<Icon name="arrow" /></a>
  </div>
  <ol class="timeline" style={`--n:${timeline.length}`}>
    {timeline.map((m) => (
      <li class:list={[m.mark && `t-${m.mark}`]} id={m.proof && `prueba-${m.proof}`} data-proof={m.proof}>
        <span class="t-dot" aria-hidden="true"></span>
        <span class="tag t-year">{m.mark === 'now' ? (lang === 'es' ? 'Hoy' : 'Today') : m.year || '\u00a0'}</span>
        <span class="t-text">{m.t[lang]}</span>
      </li>
    ))}
  </ol>
</section>

<section class="block page-x" aria-labelledby="doors-title">
  <div class="head"><h2 id="doors-title">{t.doorsTitle}</h2></div>
  <ul class="doors">
    {fronts.map((f) => (
      <li>
        <a class="door" href={`${projectsPath(lang)}?frente=${f.id}`}>
          <span class="tag">{t.doorCount(countByFront(f.id))}</span>
          <span class="d-name">{f.name[lang]}</span>
          <span class="d-blurb">{f.blurb[lang]}</span>
          <span class="d-ex">{examplesByFront(f.id, lang).join(' · ')}</span>
          <Icon name="arrow" size={18} class="d-arrow" />
        </a>
      </li>
    ))}
  </ul>
</section>

<section class="close page-x" id={contactId} aria-labelledby="close-title">
  <div class="close-body">
    <h2 id="close-title">{t.closeTitle}</h2>
    <p>{t.closeBody}</p>
    <div class="close-ctas">
      {contact.email && <a class="btn btn--primary btn--lg" href={`mailto:${contact.email}`}><Icon name="mail" />{contact.email}</a>}
      {contact.email && <CopyButton value={contact.email} label={t.copy.email} done={t.copy.done} failed={t.copy.failed} large />}
      {showMissing && !contact.email && <span class="missing">correo · {t.caseL.missing}</span>}
      <a class="btn btn--secondary btn--lg" href={contact.cv[lang]} download><Icon name="download" />{cvLabel[lang]}</a>
    </div>
    <div class="close-links">
      <a class="link" href={contact.linkedin} target="_blank" rel="noopener">LinkedIn<Icon name="external" size={16} /><span class="sr-only">{t.newTab}</span></a>
      <a class="link" href={contact.github} target="_blank" rel="noopener">GitHub<Icon name="external" size={16} /><span class="sr-only">{t.newTab}</span></a>
    </div>
  </div>
  <Footer lang={lang} />
</section>

<style>
  .soon { font-size: 12px; }
  .block { padding-top: 96px; padding-bottom: 96px; border-top: 1px solid var(--jc-hairline); display: flex; flex-direction: column; gap: 48px; }
  .block--cases { gap: 40px; }
  .head { display: flex; flex-direction: column; gap: 8px; }
  .head--row { flex-direction: row; justify-content: space-between; align-items: flex-end; gap: 16px 24px; flex-wrap: wrap; }
  h2 { font: 600 var(--jc-fs-h1)/1.1 var(--jc-font-sans); letter-spacing: var(--jc-ls-h1); }

  .numbers { padding-top: 64px; padding-bottom: 64px; background: var(--jc-surface); display: flex; flex-direction: column; gap: 32px; }
  .nums { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--jc-hairline-strong); }
  .num { padding: 28px 24px 0 0; margin-right: 24px; border-right: 1px solid var(--jc-hairline); display: flex; flex-direction: column; gap: 8px; }
  .num:last-child { border-right: 0; margin-right: 0; }
  .num dd { margin: 0; }
  .num-v { order: -1; font: 600 var(--jc-fs-display)/1 var(--jc-font-sans); letter-spacing: var(--jc-ls-display); }
  .num-l { font-size: 15px; line-height: 1.45; color: var(--jc-text-2); }
  .num-s { font: 400 12px/1.4 var(--jc-font-mono); color: var(--jc-text-3); }

  .lede { max-width: 60ch; font-size: 17px; line-height: 1.6; color: var(--jc-text-2); }
  .split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 48px; border-top: 2px solid var(--jc-ink); }
  .split h3 { padding-top: 32px; font: 600 28px/1.15 var(--jc-font-sans); letter-spacing: -.6px; }
  .who { list-style: none; padding: 0; margin-top: 16px; }
  .who li { padding: 14px 0; border-top: 1px solid var(--jc-hairline); display: flex; flex-direction: column; gap: 4px; }
  .w-name { align-self: flex-start; font: 600 17px/1.35 var(--jc-font-sans); color: var(--jc-ink); }
  a.w-name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  a.w-name:hover { text-decoration-thickness: 2px; }
  .w-note { font-size: 15px; line-height: 1.5; color: var(--jc-text-2); }

  .principles { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 48px; border-top: 2px solid var(--jc-ink); }
  .principles li { padding-top: 32px; display: flex; flex-direction: column; gap: 16px; }
  .principles h3 { font: 600 28px/1.15 var(--jc-font-sans); letter-spacing: -.6px; }
  .principles p { font-size: 17px; line-height: 1.6; color: var(--jc-text-2); }
  .principles .link, .app { align-self: flex-start; }
  .app { min-height: 44px; display: inline-flex; align-items: center; font: 600 15px/1.4 var(--jc-font-sans); color: var(--jc-text-2); }

  .cases { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 20px; }
  .case {
    display: flex; align-items: center; gap: 56px; padding: 16px; border-radius: var(--jc-radius-lg);
    border: 1px solid var(--jc-hairline); color: var(--jc-ink); text-decoration: none;
    transition: box-shadow var(--jc-dur-base) var(--jc-ease), border-color var(--jc-dur-base) var(--jc-ease);
  }
  .case.flip { flex-direction: row-reverse; }
  .case { position: relative; }
  .case.linked:hover, .case:has(.stretch:focus-visible) { box-shadow: var(--jc-shadow-3); border-color: var(--jc-hairline-strong); color: var(--jc-ink); }
  .case:has(.stretch:focus-visible) { outline: 2px solid var(--jc-focus); outline-offset: 2px; }
  .stretch::after { content: ''; position: absolute; inset: 0; border-radius: var(--jc-radius-lg); }
  .stretch:focus-visible { outline: none; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 0 24px; }
  .app-open { position: relative; z-index: 1; }
  .shot-wrap { flex: 0 0 min(50%, 560px); border: 1px solid var(--jc-hairline); aspect-ratio: 16 / 10; border-radius: var(--jc-radius-md); overflow: hidden; }
  .shot-wrap :global(.shot) { transition: transform var(--jc-dur-slow) var(--jc-ease); }
  .case.linked:hover :global(.shot) { transform: scale(1.03); }
  .body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 14px; padding: 8px 16px; }
  .meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cname { font: 600 15px/1.3 var(--jc-font-sans); }
  .hook { font: 600 32px/1.15 var(--jc-font-sans); letter-spacing: -.8px; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .read { align-self: flex-start; }
  .case.linked:hover .stretch :global(svg) { transform: translateX(4px); }

  .doors { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .door {
    position: relative; height: 100%; padding: 24px 20px 56px; border-radius: var(--jc-radius-lg); border: 1px solid var(--jc-hairline);
    display: flex; flex-direction: column; gap: 10px; color: var(--jc-ink); text-decoration: none; background: var(--jc-card);
    transition: box-shadow var(--jc-dur-base) var(--jc-ease), border-color var(--jc-dur-base) var(--jc-ease);
  }
  .door:hover { box-shadow: var(--jc-shadow-3); border-color: var(--jc-hairline-strong); color: var(--jc-ink); }
  .d-name { font: 600 20px/1.2 var(--jc-font-sans); letter-spacing: -.3px; }
  .d-blurb { font-size: 15px; line-height: 1.45; color: var(--jc-text-2); }
  .d-ex { font: 400 12px/1.45 var(--jc-font-mono); color: var(--jc-text-3); }
  .door :global(.d-arrow) { position: absolute; left: 20px; bottom: 20px; color: var(--jc-accent); transition: transform var(--jc-dur-fast) var(--jc-ease); }
  .door:hover :global(.d-arrow) { transform: translateX(4px); }

  .timeline { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 16px; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 0; right: 0; top: 6px; height: 1.5px; background: var(--jc-hairline-strong); }
  .timeline li { position: relative; display: flex; flex-direction: column; gap: 10px; padding-top: 28px; }
  .t-dot { position: absolute; top: 0; left: 0; width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--jc-hairline-strong); background: var(--jc-canvas); }
  .t-origin .t-dot { border-color: var(--jc-accent); background: var(--jc-accent); }
  .t-now .t-dot { border-color: var(--jc-ink); background: var(--jc-ink); }
  .t-origin .t-year { color: var(--jc-accent); }
  .t-text { font: 500 16px/1.35 var(--jc-font-sans); }

  .close { padding-top: 120px; padding-bottom: 48px; border-top: 1px solid var(--jc-hairline); display: flex; flex-direction: column; gap: 96px; }
  .close-body { display: flex; flex-direction: column; gap: 20px; max-width: 900px; }
  .close h2 { font: 600 var(--jc-fs-display)/1.05 var(--jc-font-sans); letter-spacing: var(--jc-ls-display); }
  .close p { font: 400 24px/1.45 var(--jc-font-sans); color: var(--jc-text-2); }
  .close-ctas { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .close-ctas .btn { padding: 0 22px; }
  .close-links { display: flex; gap: 4px 24px; flex-wrap: wrap; }

  .doppel { position: relative; z-index: 1; padding-top: 96px; padding-bottom: 96px; --jc-focus: currentColor; background: var(--jc-ink); color: var(--jc-canvas); display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 64px; align-items: center; }
  .dp-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .doppel h2 { font: 600 var(--jc-fs-display)/1.05 var(--jc-font-sans); letter-spacing: var(--jc-ls-display); }
  .doppel p { max-width: 60ch; font: 400 19px/1.55 var(--jc-font-sans); opacity: .82; }
  .dp-link { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font: 600 15px/1.3 var(--jc-font-sans); color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .dp-link :global(svg) { transition: transform var(--jc-dur-fast) var(--jc-ease); }
  .dp-link:hover { color: inherit; text-decoration-thickness: 2px; }
  .dp-link:hover :global(svg) { transform: translateX(3px); }
  .wave { height: 180px; display: flex; align-items: center; justify-content: space-between; gap: 4px; }
  .wave span { flex: 1 1 0; max-width: 8px; height: calc(var(--h) * 1%); border-radius: 4px; background: currentColor; opacity: .85; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .wave.is-on span { animation: talk 1200ms var(--jc-ease) 4 alternate; animation-delay: calc(var(--i) * -90ms); }
  }
  @keyframes talk { from { transform: scaleY(.45); } to { transform: scaleY(1); } }

  @media (max-width: 1200px) {
    .doors { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 1100px) {
    .case, .case.flip { flex-direction: column; align-items: stretch; gap: 0; padding: 8px; }
    .shot-wrap { flex: none; }
    .body { padding: 16px 8px 8px; }
    .hook { font-size: 26px; }
    .num { padding-bottom: 24px; }
    .nums { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .num:nth-child(2n) { border-right: 0; margin-right: 0; }
  }
  @media (max-width: 900px) {
    .nums { grid-template-columns: minmax(0, 1fr); }
    .num, .num:last-child { margin-right: 0; border-right: 0; border-bottom: 1px solid var(--jc-hairline); padding-right: 0; }
    .num:last-child { border-bottom: 0; }
    .doppel { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .wave { height: 96px; }
    .split { grid-template-columns: minmax(0, 1fr); }
    .split h3 { font-size: 22px; letter-spacing: -.4px; }
    .principles { grid-template-columns: minmax(0, 1fr); gap: 0; border-top: 0; }
    .principles li { padding: 16px 0; gap: 6px; border-bottom: 1px solid var(--jc-hairline); }
    .principles h3 { font-size: 22px; line-height: 1.2; letter-spacing: -.4px; }
    .principles li:last-child { padding-bottom: 0; border-bottom: 0; }
    .principles p { font-size: 15px; line-height: 1.5; }
    .principles .link, .app { font-size: 14px; }
    .doors { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .door { padding: 18px 56px 18px 18px; }
    .door :global(.d-arrow) { left: auto; right: 18px; top: 50%; bottom: auto; margin-top: -9px; }
    .timeline { grid-template-columns: minmax(0, 1fr); gap: 0; padding-left: 28px; }
    .timeline::before { left: 6px; right: auto; top: 6px; bottom: 6px; width: 1.5px; height: auto; }
    .timeline li { flex-direction: row; align-items: baseline; gap: 12px; padding: 0 0 18px; }
    .t-dot { left: -28px; top: 3px; }
    .t-year { flex: 0 0 40px; }
  }
  @media (max-width: 640px) {
    .block { padding-top: 40px; padding-bottom: 40px; gap: 16px; }
    .head h2 { font-size: 32px; letter-spacing: -.9px; }
    .numbers { padding-top: 40px; padding-bottom: 40px; gap: 16px; }
    .num { padding: 18px 0; gap: 4px; }
    .num-v { font-size: 36px; letter-spacing: -1px; }
    .num-l { font-size: 14px; }
    .doppel { padding-top: 48px; padding-bottom: 48px; }
    .doppel h2 { font-size: 32px; letter-spacing: -.9px; }
    .doppel p { font-size: 16px; }
    .cases { gap: 16px; }
    .body { gap: 6px; padding: 12px 8px 8px; }
    .meta { order: 1; }
    .cname { font-size: 20px; line-height: 1.2; }
    .hook { order: 2; font: 400 15px/1.45 var(--jc-font-sans); letter-spacing: 0; color: var(--jc-text-2); }
    .chips { order: 0; }
    .links { order: 3; }
    .shot { font-size: 11px; padding: 10px; }
    .d-name { font-size: 18px; }
    .d-blurb { font-size: 14px; }
    .close { padding-top: 48px; padding-bottom: 32px; gap: 32px; }
    .close-body { gap: 14px; }
    .close h2 { font-size: 32px; letter-spacing: -.9px; }
    .close p { font-size: 17px; line-height: 1.55; }
    .close-ctas { flex-direction: column; margin-top: 8px; }
    .close-ctas :global(.btn), .close-ctas .btn { height: 48px; font-size: 15px; width: 100%; }
  }
</style>

<script>
  // La onda habla una sola vez, menos de 5 s, cuando entra en pantalla.
  const wave = document.querySelector<HTMLElement>('[data-wave]');
  if (wave) {
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { wave.classList.add('is-on'); io.disconnect(); }
    }, { threshold: 0.4 });
    io.observe(wave);
  }
</script>
