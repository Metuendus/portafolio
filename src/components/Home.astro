---
import Hero from './Hero.astro';
import Icon from './Icon.astro';
import OrgChip from './OrgChip.astro';
import VideoFacade from './VideoFacade.astro';
import Footer from './Footer.astro';
import { ui, casePath, showMissing, type Lang } from '../i18n/ui';
import { cases, hasPage } from '../data/cases';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const projectsId = lang === 'es' ? 'proyectos' : 'projects';
const contactId = lang === 'es' ? 'contacto' : 'contact';
const brands = [
  { name: 'Iterum', shot: 'iterum' },
  { name: 'Domi', shot: 'domi' },
  { name: 'Vocatio', shot: 'vocatio' },
];
---
<Hero lang={lang} />

<section class="block page-x" aria-labelledby="thesis">
  <div class="head"><span class="tag">{t.thesisTag}</span><h2 id="thesis">{t.thesisTitle}</h2></div>
  <ol class="principles">
    {t.principles.map((p, i) => (
      <li>
        <span class="tag">{String(i + 1).padStart(2, '0')}</span>
        <h3>{p.t}</h3>
        <p>{p.d}</p>
        {hasPage(p.case)
          ? <a class="link" href={casePath(lang, p.case)}>{p.app}</a>
          : <span class="app">{p.app}</span>}
      </li>
    ))}
  </ol>
</section>

<section class="block block--cases page-x" id={projectsId} aria-labelledby="cases-title">
  <div class="head"><span class="tag">{t.casesTag}</span><h2 id="cases-title">{t.casesTitle}</h2></div>
  <ul class="cases">
    {cases.map((c, i) => {
      const linked = hasPage(c.id);
      const Tag = linked ? 'a' : 'div';
      return (
        <li>
          <Tag class:list={['case', { flip: i % 2 === 1, linked }]} href={linked ? casePath(lang, c.id) : undefined}>
            <div class="shot-wrap"><div class="shot shot-ph" data-shot={c.shot}>{showMissing ? `PLACEHOLDER · ${c.name[lang]}` : ''}</div></div>
            <div class="body">
              <div class="meta"><span class="tag">{String(i + 1).padStart(2, '0')} / 08</span><span class="bar" aria-hidden="true"></span><span class="cname">{c.name[lang]}</span></div>
              <p class="hook">{c.hook[lang]}</p>
              <div class="chips"><OrgChip lang={lang} org={c.org} status={c.status === 'post' ? 'post' : undefined} /></div>
              {linked && <span class="link read">{t.readCase}<Icon name="arrow" /></span>}
            </div>
          </Tag>
        </li>
      );
    })}
  </ul>
</section>

<section class="chassis page-x" aria-labelledby="chassis-title">
  <div class="c-left">
    <div class="head"><span class="tag">{t.chassisTag}</span><h2 id="chassis-title">{t.chassisTitle}</h2></div>
    <div class="diagram" role="img" aria-label={t.chassisDiagram}>
      <div class="apps">
        {brands.map((b) => <span class="app-node"><span class="dot" data-shot={b.shot}></span>{b.name}</span>)}
      </div>
      <div class="wires" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="base"><span class="base-name">Fundamentum</span><span class="base-sub">{t.chassisSub}</span></div>
    </div>
  </div>
  <VideoFacade lang={lang} title={t.chassisVideo} duration="1:00" poster="fundamentum" />
</section>

<section class="close page-x" id={contactId} aria-labelledby="close-title">
  <div class="close-body">
    <h2 id="close-title">{t.closeTitle}</h2>
    <p>{t.closeBody}</p>
    <div class="close-ctas">
      <a class="btn btn--primary btn--lg" href="mailto:hola@josecarloscorona.dev"><Icon name="mail" />{t.hero.cta2}</a>
      <a class="btn btn--secondary btn--lg" href="https://www.linkedin.com/in/josecarloscorona"><Icon name="linkedin" />LinkedIn</a>
    </div>
  </div>
  <Footer lang={lang} />
</section>

<style>
  .block { padding-top: 96px; padding-bottom: 96px; border-top: 1px solid var(--jc-hairline); display: flex; flex-direction: column; gap: 48px; }
  .block--cases { gap: 40px; }
  .head { display: flex; flex-direction: column; gap: 8px; }
  h2 { font: 600 var(--jc-fs-h1)/1.1 var(--jc-font-sans); letter-spacing: var(--jc-ls-h1); }

  .principles { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; border-top: 2px solid var(--jc-ink); }
  .principles li { padding-top: 32px; display: flex; flex-direction: column; gap: 16px; }
  .principles h3 { font: 600 28px/1.15 var(--jc-font-sans); letter-spacing: -.6px; }
  .principles p { font-size: 17px; line-height: 1.6; color: var(--jc-text-2); }
  .principles .link, .app { align-self: flex-start; }
  .app { min-height: 44px; display: inline-flex; align-items: center; font: 600 15px/1.4 var(--jc-font-sans); color: var(--jc-text-2); }

  .cases { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 20px; }
  .case {
    display: flex; align-items: center; gap: 56px; padding: 16px; border-radius: var(--jc-radius-lg);
    border: 1px solid var(--jc-hairline); color: var(--jc-ink); text-decoration: none;
    transition: box-shadow var(--jc-dur-base) var(--jc-ease), border-color var(--jc-dur-base) var(--jc-ease);
  }
  .case.flip { flex-direction: row-reverse; }
  .case.linked:hover, .case.linked:focus-visible { box-shadow: var(--jc-shadow-3); border-color: var(--jc-hairline-strong); color: var(--jc-ink); }
  .case:focus-visible { border-radius: var(--jc-radius-lg); }
  .shot-wrap { flex: 0 0 520px; aspect-ratio: 16 / 10; border-radius: var(--jc-radius-md); overflow: hidden; }
  .shot { width: 100%; height: 100%; transition: transform var(--jc-dur-slow) var(--jc-ease); }
  .case.linked:hover .shot { transform: scale(1.03); }
  .body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 14px; padding: 8px 16px; }
  .meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .bar { width: 1px; height: 14px; background: var(--jc-hairline-strong); }
  .cname { font: 600 15px/1.3 var(--jc-font-sans); }
  .hook { font: 600 32px/1.15 var(--jc-font-sans); letter-spacing: -.8px; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .read { align-self: flex-start; }
  .case.linked:hover .read :global(svg) { transform: translateX(4px); }

  .chassis {
    padding-top: 96px; padding-bottom: 96px; background: var(--jc-surface);
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center;
  }
  .c-left { display: flex; flex-direction: column; gap: 28px; }
  .diagram {
    padding: 28px; border-radius: var(--jc-radius-lg); border: 1px solid var(--jc-hairline);
    background-color: var(--jc-canvas); background-image: radial-gradient(var(--jc-hairline-strong) 1px, transparent 1px); background-size: 16px 16px;
  }
  .apps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .app-node {
    padding: 14px 16px; border-radius: var(--jc-radius-md); border: 1px solid var(--jc-hairline-strong); background: var(--jc-card);
    display: flex; align-items: center; gap: 10px; font: 600 15px/1.2 var(--jc-font-sans); min-width: 0;
  }
  .dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }
  .dot[data-shot='iterum'] { background: var(--jc-brand-iterum); }
  .dot[data-shot='domi'] { background: var(--jc-brand-domi); }
  .dot[data-shot='vocatio'] { background: var(--jc-brand-vocatio); }
  .wires { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; height: 36px; }
  .wires span { justify-self: center; width: 1.5px; background: var(--jc-text-3); }
  .base {
    padding: 16px 18px; border-radius: var(--jc-radius-md); border: 2px solid var(--jc-accent); background: var(--jc-accent-soft);
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px 16px;
  }
  .base-name { font: 600 17px/1.2 var(--jc-font-sans); }
  .base-sub { font: 400 12px/1.3 var(--jc-font-mono); color: var(--jc-accent); }

  .close { padding-top: 120px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 96px; }
  .close-body { display: flex; flex-direction: column; gap: 20px; max-width: 900px; }
  .close h2 { font: 600 var(--jc-fs-display)/1.05 var(--jc-font-sans); letter-spacing: var(--jc-ls-display); }
  .close p { font: 400 24px/1.45 var(--jc-font-sans); color: var(--jc-text-2); }
  .close-ctas { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .close-ctas .btn { padding: 0 22px; }

  @media (max-width: 1100px) {
    .case, .case.flip { flex-direction: column; align-items: stretch; gap: 0; padding: 8px; }
    .shot-wrap { flex: none; }
    .body { padding: 16px 8px 8px; }
    .hook { font-size: 26px; }
    .chassis { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  }
  @media (max-width: 900px) {
    .principles { grid-template-columns: minmax(0, 1fr); gap: 0; border-top: 0; }
    .principles li { padding: 16px 0; gap: 6px; border-bottom: 1px solid var(--jc-hairline); }
    .principles .tag { display: none; }
    .principles h3 { font-size: 22px; line-height: 1.2; letter-spacing: -.4px; }
    .principles p { font-size: 15px; line-height: 1.5; }
    .principles .link, .app { font-size: 14px; }
  }
  @media (max-width: 640px) {
    .block { padding-top: 40px; padding-bottom: 40px; gap: 16px; }
    .block--cases .tag { display: none; }
    .head h2 { font-size: 32px; letter-spacing: -.9px; }
    #thesis { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .cases { gap: 16px; }
    .body { gap: 6px; padding: 12px 8px 8px; }
    .meta { order: 1; }
    .meta .tag, .meta .bar { display: none; }
    .cname { font-size: 20px; line-height: 1.2; }
    .hook { order: 2; font: 400 15px/1.45 var(--jc-font-sans); letter-spacing: 0; color: var(--jc-text-2); }
    .chips { order: 0; }
    .read { order: 3; }
    .shot { font-size: 11px; padding: 10px; }
    .chassis { padding-top: 40px; padding-bottom: 40px; gap: 16px; }
    .chassis h2 { font-size: 28px; letter-spacing: -.6px; }
    .chassis .tag { display: none; }
    .diagram { padding: 12px; }
    .apps, .wires { gap: 8px; }
    .app-node { padding: 10px; font-size: 13px; gap: 6px; }
    .wires { height: 18px; }
    .base { padding: 12px; }
    .base-name { font-size: 15px; }
    .base-sub { font-size: 11px; }
    .close { padding-top: 48px; padding-bottom: 32px; gap: 32px; }
    .close-body { gap: 14px; }
    .close h2 { font-size: 32px; letter-spacing: -.9px; }
    .close p { font-size: 17px; line-height: 1.55; }
    .close-ctas { flex-direction: column; margin-top: 8px; }
    .close-ctas .btn { height: 48px; font-size: 15px; width: 100%; }
  }
</style>
