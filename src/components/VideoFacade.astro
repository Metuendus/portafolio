---
import Icon from './Icon.astro';
import { ui, showMissing, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  duration: string;
  poster: 'fundamentum' | 'iterum' | 'einstein';
  videoId?: string;
  size?: 'md' | 'lg';
}
const { lang, title, duration, poster, videoId, size = 'md' } = Astro.props;
const v = ui[lang].video;
---
<div class:list={['video', `video--${size}`]} data-poster={poster} data-video={videoId} data-loading={v.loading} data-loading-reduced={v.loadingReduced}>
  {videoId ? (
    <button type="button" class="face" aria-label={`${v.play}: ${title}, ${duration}`} data-play>
      <span class="label">{showMissing ? v.poster : ''}</span>
      <span class="play"><Icon name="play" size={size === 'lg' ? 30 : 26} /></span>
      <span class="meta"><span class="title">{title}</span><span class="dur">{duration}</span></span>
    </button>
  ) : (
    <div class="face" role="img" aria-label={`${title}, ${duration}`}>
      <span class="label">{showMissing ? v.poster : ''}</span>
      <span class="play" aria-hidden="true"><Icon name="play" size={size === 'lg' ? 30 : 26} /></span>
      <span class="meta"><span class="title">{title}</span><span class="dur">{duration}</span></span>
    </div>
  )}
  <div class="state" role="status" hidden data-status>
    <span class="spin" aria-hidden="true"></span><span data-status-text>{v.loading}</span>
  </div>
  <div class="state" hidden data-error>
    <span>{v.error}</span>
    {videoId && <a class="yt" href={`https://www.youtube.com/watch?v=${videoId}`}>{v.youtube}</a>}
  </div>
</div>

<style>
  .video { position: relative; aspect-ratio: 16 / 9; border-radius: var(--jc-radius-xl); overflow: hidden; background: var(--jc-poster-einstein); color: var(--jc-on-poster); }
  .video[data-poster='fundamentum'] { background: var(--jc-poster-fundamentum); }
  .video[data-poster='iterum'] { background: var(--jc-brand-iterum); }
  .face {
    position: absolute; inset: 0; width: 100%; height: 100%; border: 0; padding: 0; background: transparent;
    display: flex; flex-direction: column; justify-content: space-between; text-align: left; color: var(--jc-on-poster);
  }
  button.face { cursor: pointer; }
  button.face:focus-visible { outline-offset: -4px; outline-color: var(--jc-on-poster); }
  .label { padding: 24px; font: 400 12px/1 var(--jc-font-mono); min-height: 12px; }
  .video--lg .label { padding: 28px; font-size: 13px; }
  .play {
    position: absolute; left: 50%; top: 50%; width: 72px; height: 72px; margin: -36px 0 0 -36px; border-radius: 50%;
    background: var(--jc-on-poster); color: var(--jc-brand-fundamentum);
    display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(0, 0, 0, .25);
    transition: transform var(--jc-dur-fast) var(--jc-ease);
  }
  .play :global(svg) { margin-left: 3px; }
  .video--lg .play { width: 88px; height: 88px; margin: -44px 0 0 -44px; }
  button.face:hover .play { transform: scale(1.06); }
  .meta {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 24px;
    background: linear-gradient(transparent, var(--jc-poster-fade));
  }
  .video--lg .meta { padding: 28px; }
  .title { font: 600 22px/1.2 var(--jc-font-sans); letter-spacing: -.3px; }
  .video--lg .title { font-size: 26px; }
  .dur { font: 400 13px/1 var(--jc-font-mono); background: var(--jc-poster-scrim); padding: 6px 8px; border-radius: 6px; white-space: nowrap; }
  .state {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
    background: var(--jc-brand-fundamentum); font: 400 13px/1.5 var(--jc-font-mono); text-align: center; padding: 24px;
  }
  .state[hidden] { display: none; }
  .spin { width: 32px; height: 32px; border-radius: 50%; border: 3px solid rgba(255, 255, 255, .25); border-top-color: var(--jc-on-poster); animation: spin 800ms linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .spin { display: none; } }
  .yt { color: var(--jc-on-poster); font: 600 14px/1 var(--jc-font-sans); min-height: 44px; display: inline-flex; align-items: center; }
  .video :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  @media (max-width: 640px) {
    .video { border-radius: var(--jc-radius-lg); }
    .label { padding: 12px; font-size: 11px; }
    .meta, .video--lg .meta { padding: 12px; gap: 8px; }
    .title, .video--lg .title { font-size: 15px; }
    .dur { font-size: 11px; padding: 5px 7px; }
    .play, .video--lg .play { width: 56px; height: 56px; margin: -28px 0 0 -28px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.video[data-video]').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('[data-play]');
    const status = box.querySelector<HTMLElement>('[data-status]')!;
    const statusText = box.querySelector<HTMLElement>('[data-status-text]')!;
    const error = box.querySelector<HTMLElement>('[data-error]')!;
    btn?.addEventListener('click', () => {
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      statusText.textContent = (reduced ? box.dataset.loadingReduced : box.dataset.loading) ?? '';
      status.hidden = false;
      btn.hidden = true;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${box.dataset.video}?autoplay=1&rel=0`;
      frame.title = btn.getAttribute('aria-label') ?? '';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      const fail = window.setTimeout(() => { status.hidden = true; frame.remove(); error.hidden = false; }, 8000);
      frame.addEventListener('load', () => { clearTimeout(fail); status.hidden = true; frame.focus(); });
      box.append(frame);
    });
  });
</script>
