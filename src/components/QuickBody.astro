---
import Icon from './Icon.astro';
import CopyButton from './CopyButton.astro';
import SevenSeg from './SevenSeg.astro';
import { ui, projectsPath, summaryPath, contact, cvLabel, type Lang } from '../i18n/ui';

interface Props { lang: Lang; heading: 'h1' | 'h2'; inDialog?: boolean }
const { lang, heading: Heading, inDialog } = Astro.props;
const t = ui[lang];
const q = t.quick;
const L = t.caseL;
// El separador se queda al final de la línea; ninguna empieza con «·».
const keepDot = (s: string) => s.replaceAll(' · ', ' · ');
// Marca las cifras sin tocar el texto: si una cifra ya no aparece en el copy, el build truena.
const withFigs = (d: string, figs: readonly string[]) => {
  const parts: { text: string; fig?: boolean }[] = [];
  let rest = d;
  for (const f of figs) {
    const at = rest.indexOf(f);
    if (at < 0) throw new Error(`La cifra «${f}» no aparece en «${d}»`);
    parts.push({ text: rest.slice(0, at) }, { text: f, fig: true });
    rest = rest.slice(at + f.length);
  }
  parts.push({ text: rest });
  return parts;
};
let digitIndex = 0;
---
<header class="q-head">
  <Heading id="quick-title" class="q-title">{q.title}</Heading>
  <p class="q-role">{q.role}</p>
  <div class="q-side">
    <div class="q-actions">
      <a class="btn btn--primary" href={contact.cv[lang]} download><Icon name="download" />{cvLabel[lang]}</a>
      {contact.email && <CopyButton value={contact.email} label={t.copy.email} done={t.copy.done} failed={t.copy.failed} />}
      {contact.email && <a class="btn btn--secondary q-mail" href={`mailto:${contact.email}`}><Icon name="mail" />{contact.email}</a>}
    </div>
    <div class="q-meta">
      <p>{keepDot(q.where)}</p>
      <p>{keepDot(t.looking)}</p>
    </div>
  </div>
</header>

<div class="q-rack">
  <h2 class="q-label">{q.winsLabel}</h2>
  <ul class="q-mods">
    {q.wins.map((w) => (
      <li class:list={['q-mod', { 'q-mod--est': 'est' in w && w.est }]}>
        <div class="q-screen" aria-hidden="true">
          {w.reads.map((r) => (
            <div class="q-read">
              <span class="q-digits">{[...r.n].map((d) => <SevenSeg digit={d} index={digitIndex++} />)}</span>
              <span class="q-unit">{r.u}</span>
            </div>
          ))}
        </div>
        <div class="q-text">
          <h3 class="w-t">{w.t}</h3>
          <p class="w-d">{withFigs(w.d, w.figs).map((p) => (p.fig ? <b>{p.text}</b> : p.text))}</p>
          {w.s ? <p class="w-s">{L.source}: {w.s}</p> : null}
        </div>
      </li>
    ))}
  </ul>
  <h2 class="q-label">{q.stackLabel}</h2>
  <ul class="q-stack">{q.stack.map((s) => <li>{s}</li>)}</ul>
</div>

<div class="q-foot">
  <a class="link" href={projectsPath(lang)}>{q.more}<Icon name="arrow" /></a>
  {inDialog
    ? <a class="link" href={summaryPath(lang)}>{q.asPage}<Icon name="arrow" /></a>
    : <CopyButton value="location" label={t.copy.link} done={t.copy.done} failed={t.copy.failed} />}
  <div class="q-social">
    <a class="link" href={contact.linkedin} target="_blank" rel="noopener">LinkedIn<Icon name="external" size={16} /><span class="sr-only">{t.newTab}</span></a>
    <a class="link" href={contact.github} target="_blank" rel="noopener">GitHub<Icon name="external" size={16} /><span class="sr-only">{t.newTab}</span></a>
  </div>
</div>

<style>
  .q-head { display: flex; flex-direction: column; gap: 14px; }
  .q-title { font: 600 var(--jc-fs-h1)/1.05 var(--jc-font-sans); letter-spacing: var(--jc-ls-h1); }
  .q-role { font: 400 16px/1.45 var(--jc-font-sans); color: var(--jc-text-2); max-width: 64ch; }
  .q-side { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .q-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .q-actions :global(.btn), .q-actions .btn { min-width: 0; min-height: 48px; height: auto; padding: 8px 12px; border-radius: var(--jc-radius-sm); line-height: 1.15; }
  .q-mail { grid-column: 1 / -1; }
  .q-meta { font: 400 13px/1.5 var(--jc-font-mono); color: var(--jc-text-3); }

  .q-rack { display: flex; flex-direction: column; gap: 10px; padding: 10px; background: var(--jc-instr-rack); border: 1px solid var(--jc-instr-line); border-radius: var(--jc-radius-md); box-shadow: var(--jc-shadow-3); color: var(--jc-instr-text); }
  .q-rack ::selection { background: var(--jc-instr-led); color: var(--jc-instr-on-led); }
  .q-label { padding: 6px 6px 2px; font: 400 var(--jc-fs-micro)/1 var(--jc-font-mono); letter-spacing: normal; color: var(--jc-instr-text-3); }
  .q-mods { list-style: none; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
  .q-mod { display: flex; flex-direction: column; gap: 12px; min-width: 0; padding: 12px; background: var(--jc-instr-module); border: 1px solid var(--jc-instr-line); border-radius: var(--jc-radius-sm); }
  .q-screen { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 14px; padding: 14px 12px 10px; background: var(--jc-instr-screen); border: 1px solid var(--jc-instr-screen-edge); border-radius: 5px; box-shadow: var(--jc-instr-inset); }
  /* Punteado = estimación, igual que las insignias de experimento del sitio. */
  .q-mod--est .q-screen { border: 1px dashed var(--jc-instr-text-3); }
  .q-read { display: flex; flex-direction: column; gap: 8px; }
  .q-digits { display: flex; gap: 5px; transform: skewX(-5deg); transform-origin: 0 100%; }
  .q-unit { max-width: 12ch; font: 400 12px/1.25 var(--jc-font-mono); color: var(--jc-instr-text-2); }
  .q-text { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .w-t { font: 600 17px/1.25 var(--jc-font-sans); letter-spacing: -.2px; }
  .w-d { font-size: 15px; line-height: 1.45; color: var(--jc-instr-text-2); max-width: 62ch; }
  .w-d b { font-weight: 700; color: var(--jc-instr-text); }
  .w-s { font: 400 12px/1.4 var(--jc-font-mono); color: var(--jc-instr-text-3); }
  .q-stack { list-style: none; display: flex; flex-wrap: wrap; gap: 4px; padding: 0 6px 6px; }
  .q-stack li { padding: 6px 9px; background: var(--jc-instr-module); border: 1px solid var(--jc-instr-line); border-radius: 3px; font: 400 12.5px/1 var(--jc-font-mono); color: var(--jc-instr-text-2); }

  .q-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 24px; }
  .q-social { display: flex; flex-wrap: wrap; gap: 4px 24px; }

  /* El único momento de movimiento: los displays encienden. Nunca muestran otra cifra y sin él quedan fijos. */
  @media (prefers-reduced-motion: no-preference) {
    .q-screen :global(.seven) { animation: instr-power 640ms steps(1) calc(var(--i) * 55ms + 80ms) 1 none; }
    @keyframes instr-power { 0% { opacity: .2; } 14% { opacity: 1; } 22% { opacity: .35; } 36% { opacity: 1; } 48% { opacity: .7; } 60% { opacity: 1; } }
    @keyframes instr-repower { 0% { opacity: .2; } 14% { opacity: 1; } 22% { opacity: .35; } 36% { opacity: 1; } 48% { opacity: .7; } 60% { opacity: 1; } }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .q-mod:hover .q-screen :global(.seven) { animation-name: instr-repower; animation-delay: 0ms; }
  }

  /* Con ancho de sobra, la pantalla y el texto van lado a lado para no alargar la página. */
  @media (min-width: 760px) {
    .q-mod { display: grid; grid-template-columns: minmax(320px, 2fr) minmax(0, 3fr); align-items: center; gap: 20px; }
  }
  @media (min-width: 900px) {
    .q-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 48px; row-gap: 12px; align-items: start; }
    .q-title { grid-column: 1; font-size: var(--jc-fs-display); letter-spacing: var(--jc-ls-display); }
    .q-role { grid-column: 1; grid-row: 2; font-size: 18px; }
    .q-side { grid-column: 2; grid-row: 1 / 3; }
  }
  @media (min-width: 1100px) {
    .q-mods { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 1fr); }
    .q-mod { display: flex; align-items: stretch; gap: 12px; }
    .q-screen { min-height: 112px; align-items: flex-start; }
  }
</style>
