---
interface Props { name: 'arrow' | 'moon' | 'sun' | 'menu' | 'close' | 'building' | 'person' | 'archive' | 'check' | 'mail' | 'linkedin' | 'play' | 'cursor' | 'flask'; size?: number; class?: string }
const { name, size = 16, class: cls } = Astro.props;
---
{name === 'play' ? (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5z" /></svg>
) : name === 'cursor' ? (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2.5 19.5 12l-7 1.6-3.6 6.4z" fill="var(--jc-ink)" stroke="var(--jc-canvas)" stroke-width="1.5" stroke-linejoin="round" /></svg>
) : (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={name === 'building' || name === 'person' ? 2.2 : name === 'archive' ? 2.4 : 2} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
    {name === 'moon' && <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />}
    {name === 'sun' && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></>}
    {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
    {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
    {name === 'building' && <><rect x="4" y="2" width="16" height="20" rx="2" /><path d="M9 22v-4h6v4M8 6h.01M12 6h.01M16 6h.01M8 10h.01M12 10h.01M16 10h.01" /></>}
    {name === 'person' && <><circle cx="12" cy="8" r="5" /><path d="M20 21a8 8 0 0 0-16 0" /></>}
    {name === 'archive' && <><rect width="20" height="5" x="2" y="3" rx="1" /><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8M10 12h4" /></>}
    {name === 'flask' && <path d="M9 3h6M10 3v6L4.5 18.5A1.7 1.7 0 0 0 6 21h12a1.7 1.7 0 0 0 1.5-2.5L14 9V3M7 15h10" />}
    {name === 'check' && <><circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /></>}
    {name === 'mail' && <><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></>}
    {name === 'linkedin' && <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></>}
  </svg>
)}
