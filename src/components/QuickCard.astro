---
import Icon from './Icon.astro';
import QuickBody from './QuickBody.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const q = ui[lang].quick;
---
<dialog class="quick" aria-labelledby="quick-title" data-quick>
  <div class="q-head">
    <span class="tag">josecarloscorona.dev</span>
    <button type="button" class="q-close" aria-label={q.close} data-quick-close><Icon name="close" size={20} /></button>
  </div>
  <QuickBody lang={lang} heading="h2" inDialog />
</dialog>

<style>
  .quick {
    width: min(640px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); padding: 32px; overflow-y: auto;
    border: 1px solid var(--jc-hairline-strong); border-radius: var(--jc-radius-lg);
    background: var(--jc-card); color: var(--jc-ink); box-shadow: var(--jc-shadow-2);
  }
  .quick[open] { display: flex; flex-direction: column; gap: 20px; animation: q-in var(--jc-dur-slow) var(--jc-ease); }
  .quick::backdrop { background: var(--jc-scrim); }
  @keyframes q-in { from { opacity: 0; transform: translateY(8px) scale(.98); } }
  .q-head { display: flex; justify-content: space-between; align-items: center; margin: -8px -8px -8px 0; }
  .q-close { width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--jc-ink); }
  .q-close:hover { background: var(--jc-surface); }
  @media (max-width: 640px) {
    .quick { padding: 20px; }
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-quick]');
  let opener: HTMLElement | null = null;
  document.querySelectorAll<HTMLElement>('[data-quick-open]').forEach((b) =>
    b.addEventListener('click', () => { opener = b; dlg?.showModal(); }),
  );
  dlg?.querySelector('[data-quick-close]')?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg?.addEventListener('close', () => opener?.focus());
</script>
