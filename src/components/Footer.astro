---
import { ui, contact, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const t = ui[Astro.props.lang];
---
<footer class="foot">
  {contact.email ? <a href={`mailto:${contact.email}`}>{contact.email}</a> : <a href={contact.linkedin}>linkedin.com/in/josecarloscorona</a>}
  <span>{t.footer}</span>
</footer>

<style>
  .foot {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; padding-top: 24px;
    border-top: 1px solid var(--jc-hairline); font: 400 13px/1.5 var(--jc-font-mono); color: var(--jc-text-3);
  }
  .foot a { color: inherit; text-decoration: none; display: inline-block; padding: 13px 0; margin: -13px 0; }
  .foot a:hover { color: var(--jc-ink); text-decoration: underline; }
  @media (max-width: 640px) { .foot { flex-direction: column; font-size: 12px; } }
</style>
