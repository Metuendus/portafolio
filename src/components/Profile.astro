---
import Icon from './Icon.astro';
import Footer from './Footer.astro';
import { aboutPath, type Lang } from '../i18n/ui';
import { perfilCopy, secciones } from '../data/perfil';

interface Props { lang: Lang }
const { lang } = Astro.props;
const P = perfilCopy[lang];
---
<section class="intro page-x">
  <h1>{P.h1}</h1>
  <p>{P.intro}</p>
</section>

{secciones.map((s) => (
  <section class="block page-x" aria-labelledby={`${s.id}-title`}>
    <div class="head">
      <h2 id={`${s.id}-title`}>{s.titulo[lang]}</h2>
      {s.nota && <p class="nota">{s.nota[lang]}</p>}
    </div>
    <ul class="entradas">
      {s.entradas.map((e) => (
        <li class="entrada" id={e.id}>
          <div class="e-meta">
            <h3>{e.titulo[lang]}</h3>
            <p class="e-dato">{e.dato[lang]}</p>
          </div>
          <div class="e-texto">{e.texto[lang].map((p) => <p>{p}</p>)}</div>
        </li>
      ))}
    </ul>
  </section>
))}

<div class="foot page-x">
  <a class="link" href={aboutPath(lang)}>{P.volver}<Icon name="arrow" /></a>
  <Footer lang={lang} />
</div>

<style>
  .intro { padding-top: 96px; padding-bottom: 72px; display: flex; flex-direction: column; gap: 20px; }
  h1 { max-width: 1000px; font: 600 var(--jc-fs-display)/1.05 var(--jc-font-sans); letter-spacing: var(--jc-ls-display); text-wrap: balance; }
  .intro > p { max-width: 760px; font: 400 20px/1.55 var(--jc-font-sans); color: var(--jc-text-2); }

  .block { padding-top: 80px; padding-bottom: 80px; border-top: 1px solid var(--jc-hairline); display: flex; flex-direction: column; gap: 40px; }
  .head { display: flex; flex-direction: column; gap: 8px; }
  h2 { font: 600 var(--jc-fs-h1)/1.1 var(--jc-font-sans); letter-spacing: var(--jc-ls-h1); text-wrap: balance; }
  .nota { max-width: 720px; font: 400 17px/1.5 var(--jc-font-sans); color: var(--jc-text-2); }

  .entradas { list-style: none; padding: 0; display: flex; flex-direction: column; }
  .entrada { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 40px; padding: 32px 0; border-top: 1px solid var(--jc-hairline); }
  .entrada:first-child { border-top: 0; padding-top: 0; }
  .entrada:last-child { padding-bottom: 0; }
  .e-meta { display: flex; flex-direction: column; gap: 8px; }
  h3 { font: 600 22px/1.3 var(--jc-font-sans); }
  .e-dato { font: 400 15px/1.5 var(--jc-font-sans); color: var(--jc-text-2); }
  .e-texto { display: flex; flex-direction: column; gap: 14px; max-width: 68ch; }
  .e-texto p { font: 400 17px/1.6 var(--jc-font-sans); color: var(--jc-ink); }

  .foot { display: flex; flex-direction: column; gap: 32px; padding-top: 48px; padding-bottom: 48px; border-top: 1px solid var(--jc-hairline); }
  .link { align-self: flex-start; }

  @media (max-width: 1100px) {
    .entrada { grid-template-columns: 240px minmax(0, 1fr); gap: 28px; }
  }
  @media (max-width: 760px) {
    .entrada { grid-template-columns: minmax(0, 1fr); gap: 12px; }
  }
  @media (max-width: 640px) {
    .intro { padding-top: 32px; padding-bottom: 40px; gap: 14px; }
    .intro > p { font-size: 17px; }
    .block { padding-top: 48px; padding-bottom: 48px; gap: 28px; }
    h3 { font-size: 20px; }
    .e-texto p { font-size: 16px; }
    .foot { padding-top: 32px; padding-bottom: 32px; }
  }
</style>
