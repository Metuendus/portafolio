---
import Icon from './Icon.astro';
import Footer from './Footer.astro';
import CopyButton from './CopyButton.astro';
import { ui, contact, type Lang } from '../i18n/ui';
import { writingPath, fecha, minutos, wt, type Article } from '../data/escritos';

interface Props { lang: Lang; article: Article }
const { lang, article: a } = Astro.props;
const t = wt[lang];
const list = writingPath(lang);
const min = minutos(a, lang);
// README del handoff: por debajo de 2 min el tiempo de lectura se omite.
const reading = min >= 2 ? min : null;
const newTab = ui[lang].newTab;
let figura = 0;
---
<article class="art page-x">
  <aside class="data" aria-label={t.meta}>
    <a class="back" href={list}><Icon name="arrow" size={16} class="flip" />{t.back}</a>
    <dl>
      <div><dt>{t.published}</dt><dd><time datetime={a.date}>{fecha(a.date, lang)}</time></dd></div>
      {a.updated && <div><dt>{t.updated}</dt><dd><time datetime={a.updated}>{fecha(a.updated, lang)}</time></dd></div>}
      {reading && <div><dt>{t.reading}</dt><dd>{reading} min</dd></div>}
      <div><dt>{t.related}</dt><dd><a href={a.related.href[lang]}>{a.related.title[lang]}</a></dd></div>
    </dl>
    <CopyButton class="copy" value="location" label={t.copy} done={t.copied} failed={ui[lang].copy.failed} />
  </aside>

  <div class="col">
    <header class="head">
      <p class="meta-m">
        <time datetime={a.date}>{fecha(a.date, lang)}</time>{reading && ` · ${reading} ${t.readingM}`}
        {a.updated && <><br />{t.updatedOn} <time datetime={a.updated}>{fecha(a.updated, lang)}</time></>}
      </p>
      <h1>{a.title[lang]}</h1>
      <p class="dek">{a.dek[lang]}</p>
    </header>

    {a.body[lang].map((b) => {
      if (b.k === 'p') return <p class="p">{b.t}</p>;
      if (b.k === 'h2') return <h2>{b.t}</h2>;
      if (b.k === 'h3') return <h3>{b.t}</h3>;
      if (b.k === 'ol') return (
        <ol class="ol" role="list">
          {b.items.map((i, n) => <li><span class="n" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span><span>{i}</span></li>)}
        </ol>
      );
      if (b.k === 'ul') return <ul class="ul" role="list">{b.items.map((i) => <li><span class="sq" aria-hidden="true"></span><span>{i}</span></li>)}</ul>;
      if (b.k === 'quote') return (
        <figure class="quote">
          <div class="q-box">
            <div class="q-head">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 6H3M21 12H8M21 18H8M3 12v6" /></svg>
              {t.quoteLabel} · {t.quoteNote}
            </div>
            <blockquote lang={b.lang}>{b.text}</blockquote>
            {b.tr && <p class="q-tr"><span class="tag">{t.translation}</span> {b.tr}</p>}
          </div>
          <figcaption>{b.cap}</figcaption>
        </figure>
      );
      if (b.k === 'figs') return (
        <div class="figs">
          {b.items.map((f) => (
            <div class="fig">
              <span class="v">{f.v}</span>
              <span class="l">{f.l}</span>
              <span class="src">{t.source} <a href="#procedencia">{a.sources.run[lang].charAt(0).toLowerCase() + a.sources.run[lang].slice(1)}</a></span>
            </div>
          ))}
        </div>
      );
      if (b.k === 'figure') {
        figura += 1;
        return (
          <figure class="shot" data-shot>
            <div class="frame" style={`aspect-ratio:${b.width}/${b.height}`}>
              <img class="i-light" src={b.light} alt={b.alt} width={b.width} height={b.height} loading="lazy" decoding="async" />
              <img class="i-dark" src={b.dark} alt={b.alt} width={b.width} height={b.height} loading="lazy" decoding="async" />
              <div class="fail" hidden>
                <p class="fail-alt">{b.alt}</p>
                <p class="fail-t" aria-live="polite">{t.imgFailed}</p>
                <button type="button" class="btn btn--secondary retry" data-retry data-retrying={t.retrying}>{t.retry}</button>
              </div>
            </div>
            <figcaption><span class="tag">{t.figure} {figura}</span> {b.cap}</figcaption>
          </figure>
        );
      }
      if (b.k === 'code') return (
        <figure class="code">
          <figcaption><span>{b.label}</span><span>{b.fmt}</span></figcaption>
          <div class="scroll" tabindex="0" role="region" aria-label={b.label} data-scroll><pre><code>{b.code}</code></pre></div>
          <p class="swipe" hidden>{t.swipe}</p>
        </figure>
      );
      if (b.k === 'table') return (
        <div class="tbl" tabindex="0" role="region" aria-label={b.cap}>
          <table>
            <caption>{b.cap}</caption>
            <thead><tr><th scope="col">{b.head[0]}</th><th scope="col">{b.head[1]}</th></tr></thead>
            <tbody>{b.rows.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td></tr>)}</tbody>
          </table>
        </div>
      );
      if (b.k !== 'findings') return null;
      return (
        <div class="findings">
          <div class="card">
            <span class="lab"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>{t.finding}</span>
            <p>{b.finding}</p>
          </div>
          <div class="card">
            <span class="lab"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2M19 3a2 2 0 0 1 2 2M21 19a2 2 0 0 1-2 2M5 21a2 2 0 0 1-2-2M9 3h1M9 21h1M14 3h1M14 21h1M3 9v1M21 9v1M3 14v1M21 14v1" /></svg>{t.limits}</span>
            <p>{b.limit}</p>
          </div>
        </div>
      );
    })}

    <aside class="prov" id="procedencia" aria-label={t.provenanceAria}>
      <div class="prov-d">
        <span class="prov-l"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14a9 3 0 0 0 18 0V5M3 12a9 3 0 0 0 18 0" /></svg>{t.provenance}</span>
        <span>{a.sources.run[lang]}</span><span class="dot" aria-hidden="true">·</span><span>commit <span class="commit">{a.sources.commit}</span></span>
      </div>
      <div class="prov-links">
        {a.sources.links.map((k) => (
          <a href={k.href[lang]} target="_blank" rel="noopener">{k.t[lang]}<Icon name="external" size={14} /><span class="sr-only">{newTab}</span></a>
        ))}
      </div>
    </aside>

    <div class="close">
      <div class="cards">
        <a class="rel" href={a.related.href[lang]}>
          <span class="tag">{t.related} · {a.related.place[lang].toUpperCase()}</span>
          <span class="rel-t">{a.related.title[lang]}</span>
          <span class="rel-d">{a.related.desc[lang]}</span>
          <span class="rel-c">{a.related.cta[lang]}<Icon name="arrow" size={16} /></span>
        </a>
        <div class="mail">
          <span class="tag">{t.mail}</span>
          <span class="mail-t">{a.mail.title[lang]}</span>
          <span class="mail-d">{a.mail.text[lang]}</span>
          <a class="btn btn--primary mail-b" href={`mailto:${contact.email}`}><Icon name="mail" size={16} /><span class="addr">{contact.email}</span><span class="addr-m">{t.mailM}</span></a>
        </div>
      </div>
      <a class="all" href={list}><Icon name="arrow" size={16} class="flip" />{t.backAll}</a>
    </div>

    <div class="foot"><Footer lang={lang} /></div>
  </div>
</article>

<script>
  // Imagen que falla (handoff 4g): el marco conserva su proporción y ofrece reintentar.
  document.querySelectorAll<HTMLElement>('[data-shot]').forEach((fig) => {
    const fail = fig.querySelector<HTMLElement>('.fail')!;
    const btn = fig.querySelector<HTMLButtonElement>('[data-retry]')!;
    const label = btn.textContent ?? '';
    const imgs = [...fig.querySelectorAll<HTMLImageElement>('img')];
    const visible = () => imgs.find((i) => getComputedStyle(i).display !== 'none');
    const show = (failed: boolean) => { fail.hidden = !failed; fig.toggleAttribute('data-failed', failed); btn.textContent = label; btn.disabled = false; };
    imgs.forEach((img) => {
      img.addEventListener('error', () => { if (img === visible()) show(true); });
      img.addEventListener('load', () => { if (img === visible()) show(false); });
      if (img.complete && img.naturalWidth === 0 && img === visible()) show(true);
    });
    btn.addEventListener('click', () => {
      const img = visible();
      if (!img) return;
      btn.textContent = btn.dataset.retrying ?? label;
      btn.disabled = true;
      const src = img.getAttribute('src') ?? '';
      img.src = `${src.split('?')[0]}?r=${Date.now()}`;
    });
  });

  // El aviso de deslizar solo aparece si el código de verdad se sale de su caja.
  const hints = () => document.querySelectorAll<HTMLElement>('.code').forEach((c) => {
    const box = c.querySelector<HTMLElement>('[data-scroll]')!;
    c.querySelector<HTMLElement>('.swipe')!.hidden = box.scrollWidth - box.clientWidth <= 1;
  });
  hints();
  addEventListener('resize', hints);
</script>

<style>
  .art { padding-top: 64px; padding-bottom: 48px; display: grid; grid-template-columns: 280px minmax(0, 1fr); column-gap: 64px; }

  /* Columna de datos */
  .data { align-self: start; position: sticky; top: 96px; display: flex; flex-direction: column; gap: 28px; }
  .back { align-self: flex-start; height: 44px; margin-top: -8px; display: inline-flex; align-items: center; gap: 8px; font: 600 15px/1 var(--jc-font-sans); color: var(--jc-ink); text-decoration: none; }
  .back:hover { color: var(--jc-accent); }
  .art :global(.flip) { transform: scaleX(-1); }
  dl { margin: 0; display: flex; flex-direction: column; gap: 16px; font: 400 13px/1.4 var(--jc-font-mono); }
  dl div { display: flex; flex-direction: column; gap: 4px; }
  dt { font-size: 12px; color: var(--jc-text-3); }
  dd { margin: 0; color: var(--jc-ink); }
  dd a { color: var(--jc-accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  dd a:hover { color: var(--jc-accent-hover); }
  .data :global(.copy) { align-self: flex-start; padding: 0 16px; border-color: var(--jc-hairline-strong); font-size: 14px; }

  /* Encabezado */
  .col { min-width: 0; max-width: 856px; display: flex; flex-direction: column; gap: 24px; }
  .head { display: flex; flex-direction: column; gap: 24px; padding-bottom: 24px; }
  .meta-m { display: none; font: 400 12px/1.5 var(--jc-font-mono); color: var(--jc-text-3); }
  h1 { font: 600 56px/1.05 var(--jc-font-sans); letter-spacing: -1.8px; }
  .dek { max-width: 720px; font: 400 24px/1.45 var(--jc-font-sans); color: var(--jc-text-2); }

  /* Cuerpo */
  .p, h2, h3, .ol, .ul, .quote, .figs, .tbl { max-width: 640px; }
  .p { font-size: 19px; line-height: 1.65; color: var(--jc-text-2); }
  h2 { margin-top: 32px; font: 600 28px/1.15 var(--jc-font-sans); letter-spacing: -.6px; }
  h3 { margin-top: 16px; font: 600 20px/1.25 var(--jc-font-sans); letter-spacing: -.3px; }

  .ol { list-style: none; padding: 0; border-bottom: 1px solid var(--jc-hairline); }
  .ol li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 4px; padding: 14px 0; border-top: 1px solid var(--jc-hairline); font-size: 19px; line-height: 1.6; color: var(--jc-text-2); text-wrap: pretty; }
  .ol .n { font: 400 13px/1.95 var(--jc-font-mono); color: var(--jc-text-3); }
  .ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .ul li { display: grid; grid-template-columns: 24px minmax(0, 1fr); font-size: 19px; line-height: 1.6; color: var(--jc-text-2); text-wrap: pretty; }
  .sq { width: 6px; height: 6px; margin-top: 13px; border-radius: 1px; background: var(--jc-text-3); }

  /* Texto citado ajeno (DS 15) */
  .quote { margin: 8px 0; display: flex; flex-direction: column; gap: 10px; }
  .q-box { border: 1.5px dashed var(--jc-hairline-strong); border-radius: 12px; background: var(--jc-canvas); }
  .q-head { display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-bottom: 1.5px dashed var(--jc-hairline-strong); font: 400 12px/1.4 var(--jc-font-mono); color: var(--jc-text-3); }
  .q-head svg { flex-shrink: 0; }
  blockquote { padding: 20px 18px 22px; font: 500 17px/1.6 var(--jc-font-sans); color: var(--jc-ink); text-wrap: pretty; }
  .q-tr { padding: 0 18px 20px; font-size: 15px; line-height: 1.55; color: var(--jc-text-2); }
  .quote figcaption, .shot figcaption { font-size: 14px; line-height: 1.45; color: var(--jc-text-2); }

  /* Cifra con fuente */
  .figs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--jc-hairline); border-bottom: 1px solid var(--jc-hairline); }
  .fig { padding: 28px 28px 28px 0; display: flex; flex-direction: column; gap: 8px; }
  .fig + .fig { padding: 28px 0 28px 28px; border-left: 1px solid var(--jc-hairline); }
  .v { font: 600 56px/1 var(--jc-font-sans); letter-spacing: -1.8px; }
  .l { font-size: 15px; line-height: 1.45; color: var(--jc-text-2); text-wrap: pretty; }
  .src { font: 400 12px/1.4 var(--jc-font-mono); color: var(--jc-text-3); }
  .src a { color: var(--jc-text-3); text-decoration: underline; text-decoration-color: var(--jc-hairline-strong); text-underline-offset: 3px; }
  .src a:hover { color: var(--jc-ink); }

  /* Figura */
  .shot { margin: 16px 0; display: flex; flex-direction: column; gap: 12px; }
  .frame { position: relative; border-radius: 12px; border: 1px solid var(--jc-hairline); background: var(--jc-surface); overflow: hidden; }
  .frame img { width: 100%; height: 100%; object-fit: cover; }
  .i-dark { display: none; }
  :global([data-theme='dark']) .i-light { display: none; }
  :global([data-theme='dark']) .i-dark { display: block; }
  .shot[data-failed] img { visibility: hidden; }
  .fail { position: absolute; inset: 0; padding: 24px; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: 10px; }
  .fail[hidden] { display: none; }
  .fail-alt { margin-bottom: auto; max-width: 60ch; font: 400 13px/1.5 var(--jc-font-mono); color: var(--jc-text-2); }
  .fail-t { font-size: 15px; color: var(--jc-ink); }
  .retry { height: 36px; padding: 0 16px; font-size: 14px; }

  /* Código */
  .code { margin: 8px 0; display: flex; flex-direction: column; border-radius: 12px; border: 1px solid var(--jc-hairline); background: var(--jc-surface); overflow: hidden; }
  .code figcaption { display: flex; justify-content: space-between; gap: 16px; padding: 10px 18px; border-bottom: 1px solid var(--jc-hairline); font: 400 12px/1.4 var(--jc-font-mono); color: var(--jc-text-3); }
  .scroll { overflow-x: auto; }
  pre { margin: 0; padding: 16px 18px; font: 400 13px/1.7 var(--jc-font-mono); color: var(--jc-ink); white-space: pre; }
  .swipe { padding: 0 18px 12px; font: 400 12px/1.4 var(--jc-font-mono); color: var(--jc-text-3); }

  /* Tabla */
  .tbl { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 16px; line-height: 1.45; }
  caption { caption-side: top; text-align: left; padding-bottom: 12px; font: 400 12px/1.4 var(--jc-font-mono); color: var(--jc-text-3); }
  th { text-align: left; padding: 10px 24px 10px 0; border-bottom: 1px solid var(--jc-hairline-strong); font: 400 12px/1.4 var(--jc-font-mono); color: var(--jc-text-3); }
  td { padding: 12px 24px 12px 0; border-bottom: 1px solid var(--jc-hairline); color: var(--jc-text-2); vertical-align: top; }
  th:last-child, td:last-child { padding-right: 0; text-align: right; white-space: nowrap; }
  td:last-child { color: var(--jc-ink); }

  /* Hallazgo y límites (DS 17) */
  .findings { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 8px 0; }
  .card { border: 1px solid var(--jc-hairline); border-radius: 16px; padding: 28px 32px; background: var(--jc-card); display: flex; flex-direction: column; gap: 16px; }
  .lab { display: inline-flex; align-items: center; gap: 8px; font: 400 12px/1 var(--jc-font-mono); color: var(--jc-text-2); }
  .card p { font: 500 22px/1.4 var(--jc-font-sans); letter-spacing: -.2px; color: var(--jc-ink); }

  /* Procedencia (DS 16) */
  .prov { margin-top: 32px; padding: 14px 24px; border-radius: 12px; background: var(--jc-surface); border: 1px solid var(--jc-hairline); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 32px; }
  .prov-d { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; font: 400 13px/1.4 var(--jc-font-mono); color: var(--jc-text-2); }
  .prov-l { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; color: var(--jc-text-3); }
  .dot { color: var(--jc-text-3); }
  .commit { color: var(--jc-ink); }
  .prov-links { display: flex; flex-wrap: wrap; gap: 0 24px; }
  .prov-links a { height: 44px; display: inline-flex; align-items: center; gap: 6px; font: 600 15px/1 var(--jc-font-sans); color: var(--jc-accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .prov-links a:hover { text-decoration-thickness: 2px; }

  /* Cierre (DS 18) */
  .close { margin-top: 72px; padding-top: 40px; border-top: 2px solid var(--jc-ink); display: flex; flex-direction: column; gap: 32px; }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .rel { padding: 28px 32px; border-radius: 16px; border: 1px solid var(--jc-hairline); display: flex; flex-direction: column; gap: 10px; color: var(--jc-ink); text-decoration: none; transition: box-shadow var(--jc-dur-fast) var(--jc-ease), border-color var(--jc-dur-fast) var(--jc-ease); }
  .rel:hover { box-shadow: var(--jc-shadow-3); border-color: var(--jc-hairline-strong); }
  .rel-t { font: 600 28px/1.15 var(--jc-font-sans); letter-spacing: -.6px; text-wrap: balance; }
  .rel-d, .mail-d { font-size: 15px; line-height: 1.5; color: var(--jc-text-2); }
  .rel-c { margin-top: auto; padding-top: 8px; display: inline-flex; align-items: center; gap: 6px; font: 600 15px/1 var(--jc-font-sans); color: var(--jc-accent); }
  .mail { padding: 28px 32px; border-radius: 16px; background: var(--jc-surface); display: flex; flex-direction: column; gap: 10px; }
  .mail-t { font: 600 20px/1.3 var(--jc-font-sans); letter-spacing: -.3px; text-wrap: balance; }
  .mail-b { margin-top: auto; align-self: flex-start; padding: 0 18px; }
  .addr-m { display: none; }
  .all { align-self: flex-start; height: 44px; display: inline-flex; align-items: center; gap: 8px; font: 600 15px/1 var(--jc-font-sans); color: var(--jc-ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .all:hover { text-decoration-thickness: 2px; }
  .foot { margin-top: 48px; }

  @media (max-width: 1100px) {
    .art { grid-template-columns: 220px minmax(0, 1fr); column-gap: 40px; }
  }

  @media (max-width: 900px) {
    .art { grid-template-columns: minmax(0, 1fr); padding-top: 16px; }
    .data { position: static; flex-direction: row; align-items: center; justify-content: space-between; gap: 12px; }
    .data dl { display: none; }
    .back { margin-top: 0; }
    .data :global(.copy) { width: 44px; padding: 0; border-radius: 50%; }
    .data :global(.copy [data-copy-text]) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .col { gap: 20px; }
    .head { gap: 16px; padding: 12px 0 8px; }
    .meta-m { display: block; }
    h1 { font-size: 32px; line-height: 1.1; letter-spacing: -.9px; }
    .dek { font-size: 18px; line-height: 1.5; }
    .p, .ol li, .ul li { font-size: 17px; line-height: 1.6; }
    h2 { margin-top: 20px; font-size: 24px; }
    blockquote { font-size: 16px; }
    .figs { grid-template-columns: minmax(0, 1fr); }
    .fig, .fig + .fig { padding: 20px 0; border-left: 0; }
    .fig + .fig { border-top: 1px solid var(--jc-hairline); }
    .v { font-size: 40px; letter-spacing: -1.2px; }
    pre { font-size: 12px; }
    .findings, .cards { grid-template-columns: minmax(0, 1fr); }
    .card, .rel, .mail { padding: 20px; }
    .card p { font-size: 18px; }
    .retry { height: 44px; }
    .prov { flex-direction: column; align-items: flex-start; padding: 14px 20px; }
    .prov-links { flex-direction: column; }
    .close { margin-top: 48px; padding-top: 32px; }
    .rel-t { font-size: 24px; }
    .mail-b { align-self: stretch; height: 48px; }
    .addr { display: none; }
    .addr-m { display: inline; }
  }
</style>
