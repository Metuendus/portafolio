---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { contact, type Lang } from '../i18n/ui';

interface Props { lang: Lang; title: string; description: string; altHref: string; current?: string; bare?: boolean }
const { lang, title, description, altHref, current, bare } = Astro.props;
const skip = lang === 'es' ? 'Saltar al contenido' : 'Skip to content';
const site = Astro.site ?? new URL('https://josecarloscorona.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const og = new URL(`/og-${lang}.png`, site).href;
const esHref = new URL(lang === 'es' ? Astro.url.pathname : altHref, site).href;
const enHref = new URL(lang === 'en' ? Astro.url.pathname : altHref, site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'José Carlos Corona',
  url: site.href,
  jobTitle: 'AI & Automation Lead',
  worksFor: { '@type': 'Organization', name: 'EPA.Digital' },
  address: { '@type': 'PostalAddress', addressLocality: 'Ciudad de México', addressCountry: 'MX' },
  email: contact.email ?? undefined,
  sameAs: [contact.linkedin, contact.github],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {bare ? <meta name="robots" content="noindex" /> : <>
      <link rel="alternate" hreflang="es" href={esHref} />
      <link rel="alternate" hreflang="en" href={enHref} />
      <link rel="alternate" hreflang="x-default" href={esHref} />
      <link rel="canonical" href={canonical} />
      <script type="application/ld+json" set:html={JSON.stringify(person)} />
    </>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="José Carlos Corona" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1011" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('jc-theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Fragment+Mono&display=swap" />
  </head>
  <body>
    <a class="skip" href="#main">{skip}</a>
    {!bare && <Nav lang={lang} current={current} altHref={altHref} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
