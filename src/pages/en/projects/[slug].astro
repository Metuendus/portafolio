---
import Base from '../../../layouts/Base.astro';
import CasePage from '../../../components/CasePage.astro';
import { cases, details } from '../../../data/cases';
import { casePath } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(details).map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const c = cases.find((x) => x.id === slug)!;
---
<Base lang="en" title={`${c.name.en} · José Carlos Corona`} description={c.hook.en} altHref={casePath('es', slug)} current="projects">
  <CasePage lang="en" id={slug} />
</Base>
