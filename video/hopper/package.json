{
  "name": "video-hopper",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:es": "remotion render src/index.ts hopper-es out/hopper-es.mp4",
    "render:en": "remotion render src/index.ts hopper-en out/hopper-en.mp4",
    "poster": "remotion still src/index.ts hopper-es out/hopper-poster-es.jpg --frame=880 --image-format=jpeg"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
